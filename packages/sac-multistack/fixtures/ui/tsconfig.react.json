{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "jsx": "react-jsx"
  },
  "include": [
    "react/src/**/*.ts",
    "react/src/**/*.tsx"
  ]
}
