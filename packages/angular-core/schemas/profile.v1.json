{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
    },
    "angular_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(?:-[A-Za-z0-9.-]{1,32})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "angular-only",
        "hybrid",
        "non-angular"
      ]
    },
    "mount": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^/(?:[A-Za-z0-9_-]+/)*$"
    },
    "bundle_hints": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\%?#:\\s])(?!.*//)(?!.*\\/$)[A-Za-z0-9_./-]+$"
            },
            "angular_host": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]+$",
              "maxLength": 100
            },
            "angular_entrypoints": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\%?#:\\s])(?!.*//)(?!.*\\/$)[A-Za-z0-9_./-]+$"
              },
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\%?#:\\s])(?!.*//)(?!.*\\/$)[A-Za-z0-9_./-]+$"
              },
              "minItems": 0,
              "maxItems": 256,
              "uniqueItems": true
            },
            "legacy_react_entrypoints": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\%?#:\\s])(?!.*//)(?!.*\\/$)[A-Za-z0-9_./-]+$"
              },
              "minItems": 0,
              "maxItems": 256,
              "uniqueItems": true
            }
          },
          "required": [
            "index",
            "angular_host",
            "angular_entrypoints",
            "assets",
            "legacy_react_entrypoints"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(?:-[A-Za-z0-9.-]{1,32})?$"
          },
          "required": {
            "type": "boolean"
          },
          "enforcement": {
            "enum": [
              "blocking",
              "observe"
            ]
          }
        },
        "required": [
          "rule_id",
          "version",
          "required",
          "enforcement"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "angular_version",
    "capabilities",
    "mode",
    "mount",
    "bundle_hints",
    "rules"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAC Project Profile v1"
}
